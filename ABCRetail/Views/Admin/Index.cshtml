@{
    ViewData["Title"] = "Admin Dashboard";
    var queueMessages = ViewBag.QueueMessages as List<string> ?? new List<string>();
}

<div class="container py-3">
    <h2 class="fw-bold text-dark mb-3">Admin Portal: Processing Queue Monitor</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- AZURE QUEUE STORAGE MONITOR (Full Width) -->
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white fw-bold d-flex justify-content-between align-items-center">
                    <span>📦 Active Processing Queue ('orders')</span>
                    <span class="badge bg-light text-dark fs-6">Active Messages: @queueMessages.Count</span>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered align-middle mb-0">
                            <thead class="table-secondary">
                                <tr>
                                    <th style="width: 5%;" class="text-center">#</th>
                                    <th>Processing Details (Orders, Inventory & Uploads)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (queueMessages.Any())
                                {
                                    int idx = 1;
                                    foreach (var msg in queueMessages)
                                    {
                                        <tr>
                                            <td class="fw-bold text-center">@idx</td>
                                            <td>
                                                @if (msg.Contains("Uploading image"))
                                                {
                                                    <span class="badge bg-info text-dark me-2">Image Upload</span>
                                                }
                                                else if (msg.Contains("Processing order"))
                                                {
                                                    <span class="badge bg-success me-2">Order</span>
                                                }
                                                else if (msg.Contains("inventory"))
                                                {
                                                    <span class="badge bg-warning text-dark me-2">Inventory</span>
                                                }
                                                else if (msg.Contains("customer"))
                                                {
                                                    <span class="badge bg-primary me-2">Customer Profile</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary me-2">System</span>
                                                }
                                                <code class="fs-6 text-dark">@msg</code>
                                            </td>
                                        </tr>
                                        idx++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="2" class="text-center text-muted py-4">
                                            No active processing messages currently in queue.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>