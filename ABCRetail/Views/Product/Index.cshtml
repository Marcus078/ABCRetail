@model List<ABCRetail.Models.Product>
@{
    ViewData["Title"] = "Product Catalog";
}

<div class="container py-3">
    <h2 class="fw-bold text-success mb-3">Product Catalog</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- PRODUCT CREATION FORM -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white fw-bold">Add New Product</div>
        <div class="card-body">
            <form asp-controller="Product" asp-action="AddProduct" method="post" enctype="multipart/form-data">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Product Name</label>
                        <input type="text" name="ProductName" class="form-control" required placeholder="e.g. Wireless Mouse" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Price (R)</label>
                        <input type="number" step="0.01" name="Price" class="form-control" required placeholder="e.g. 450.00" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Stock Quantity</label>
                        <input type="number" name="StockQuantity" class="form-control" required placeholder="e.g. 25" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Product Image</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" required />
                    </div>
                    <div class="col-12 mt-3">
                        <button type="submit" class="btn btn-success w-100 fw-bold">Save Product</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- PRODUCT CATALOG LIST -->
    <h4 class="fw-bold mb-3">Current Catalog</h4>
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var prod in Model)
            {
                var displayImgUrl = !string.IsNullOrWhiteSpace(prod.ImageUrl)
                ? prod.ImageUrl
                : "https://via.placeholder.com/300x180?text=No+Image";

                <div class="col-md-3">
                    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                        <img src="@displayImgUrl"
                             class="card-img-top"
                             alt="@prod.ProductName"
                             style="height: 180px; object-fit: cover;"
                             onerror="this.onerror=null; this.src='https://via.placeholder.com/300x180?text=Image+Unavailable';" />

                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <h5 class="card-title fw-bold text-dark mb-1">@prod.ProductName</h5>
                                <p class="card-text text-muted small mb-2">Available Stock: @prod.StockQuantity</p>
                            </div>
                            <h6 class="text-success fw-bold mb-0">R @prod.Price.ToString("F2")</h6>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-muted">No products available in the catalog yet. Use the form above to add items.</div>
        }
    </div>
</div>