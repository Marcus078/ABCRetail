@model List<ABCRetail.Models.CustomerProfile>

@{
    ViewData["Title"] = "Customer Management";
}

<div class="container py-3">
    <h2 class="fw-bold text-primary mb-3">Customer Management</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ADD CUSTOMER FORM -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white fw-bold">Register New Customer</div>
        <div class="card-body">
            <form asp-controller="Customer" asp-action="AddCustomer" method="post">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">First Name</label>
                        <input type="text" name="FirstName" class="form-control" required placeholder="First name" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Last Name</label>
                        <input type="text" name="LastName" class="form-control" required placeholder="Last name" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Email Address</label>
                        <input type="email" name="Email" class="form-control" required placeholder="name@example.com" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Phone Number</label>
                        <input type="text" name="PhoneNumber" class="form-control" required placeholder="Phone number" />
                    </div>
                    <div class="col-12 mt-3">
                        <button type="submit" class="btn btn-primary w-100">Save Customer</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- CUSTOMER LIST -->
    <h4 class="fw-bold mb-3">Registered Customers</h4>
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Customer Reference</th>
                <th>Full Name</th>
                <th>Email Address</th>
                <th>Phone Number</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var cust in Model)
                {
                    <tr>
                        <td>@cust.RowKey</td>
                        <td>@cust.FirstName @cust.LastName</td>
                        <td>@cust.Email</td>
                        <td>@cust.PhoneNumber</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No customers registered yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>