@model IEnumerable<ABCRetail.Models.Product>
@{
    ViewData["Title"] = "Storefront";
    var customers = ViewBag.Customers as List<ABCRetail.Models.CustomerProfile> ?? new List<ABCRetail.Models.CustomerProfile>();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-0">🛍️ ABC Retail Storefront</h2>
            <p class="text-muted mb-0">Choose an item, select a customer, and place your order.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <strong>Success!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <strong>Order Failed:</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                var displayImgUrl = !string.IsNullOrWhiteSpace(item.ImageUrl)
                ? item.ImageUrl
                : "https://via.placeholder.com/400x250?text=No+Product+Image";

                bool isOutOfStock = item.StockQuantity <= 0;

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">

                        <div class="bg-light text-center position-relative" style="height: 220px; overflow: hidden;">
                            <img src="@displayImgUrl"
                                 class="card-img-top h-100 w-100"
                                 alt="@item.ProductName"
                                 style="object-fit: cover;"
                                 onerror="this.onerror=null; this.src='https://via.placeholder.com/400x250?text=Image+Not+Found';" />

                            <!-- Stock Indicator Badge -->
                            <span class="position-absolute top-0 end-0 m-2 badge @(isOutOfStock ? "bg-danger" : "bg-dark")">
                                @(isOutOfStock ? "Out of Stock" : $"In Stock: {item.StockQuantity}")
                            </span>
                        </div>

                        <div class="card-body d-flex flex-column justify-content-between p-4">
                            <div>
                                <h5 class="card-title fw-bold text-dark mb-1">@item.ProductName</h5>
                                <h4 class="text-primary fw-bold mb-3">R @item.Price.ToString("F2")</h4>
                            </div>

                            <form asp-controller="Store" asp-action="PlaceOrder" method="post" class="mt-2">
                                <input type="hidden" name="productName" value="@item.ProductName" />
                                <input type="hidden" name="price" value="@item.Price" />

                                <!-- Customer Picker -->
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold text-muted mb-1">Customer Profile:</label>
                                    <select name="customerEmail" class="form-select form-select-sm" required @(isOutOfStock ? "disabled" : "")>
                                        <option value="">-- Choose Customer --</option>
                                        @foreach (var cust in customers)
                                        {
                                            <option value="@cust.Email">@cust.FirstName @cust.LastName (@cust.Email)</option>
                                        }
                                    </select>
                                </div>

                                <!-- Quantity Picker -->
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-muted mb-1">Quantity:</label>
                                    <input type="number"
                                           name="quantity"
                                           class="form-control form-select-sm"
                                           value="1"
                                           min="1"
                                           max="@item.StockQuantity"
                                           required
                                           @(isOutOfStock ? "disabled" : "") />
                                </div>

                                <button type="submit"
                                        class="btn @(isOutOfStock ? "btn-secondary" : "btn-warning") w-100 fw-bold shadow-sm"
                                        @(isOutOfStock ? "disabled" : "")>
                                    🛒 @(isOutOfStock ? "Sold Out" : "Place Order")
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="card border-0 bg-light p-5">
                    <h4 class="text-muted mb-2">No Products Available</h4>
                    <p class="text-secondary mb-3">Your store catalog is currently empty.</p>
                </div>
            </div>
        }
    </div>
</div>